{
  "name": "bb-plugin-thread-kanban",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "mcp": "node mcp.mjs",
    "test:agents": "node --test agent.test.mjs mcp.test.mjs",
    "build": "bb plugin build",
